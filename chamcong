        if(ed.type==="checkbox")return `<td class="ed c ${cls}"><input type="checkbox" ${attrs} ${raw?"checked":""} aria-label="${esc(c.h)}"></td>`;
        return `<td class="ed ${cls}"><input type="${ed.type==="text"?"text":ed.type}" ${ed.type==="number"?'step="any"':""} ${attrs} value="${esc(raw)}" aria-label="${esc(c.h)}"${ed.k==="sinhNhat"||ed.k==="congAnLe"?` placeholder="${esc(fmtCell(c,v))}"`:""}></td>`}
      return `<td class="${cls}">${fmtCell(c,v)}</td>`}).join("")+`</tr>`}
  if(!sh.rows.length)h+=`<tr><td colspan="${cols.length}" class="empty">Không có dòng nào.</td></tr>`;
  const sums=cols.map(c=>(c.t==="money"||c.t==="num")&&c.sum!==false?sh.rows.filter(r=>!r.dept).reduce((a,r)=>a+(+cellVal(c,r)||0),0):null);
