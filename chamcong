<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Chấm công Classyc</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#EDF0F3;--surface:#FFFFFF;--surface2:#F6F8FA;--ink:#142433;--muted:#5B6B7A;--line:#D5DCE3;
  --brand:#12355B;--brand-ink:#FFFFFF;--focus:#2F6FD6;
  --ok:#0E6B58;--ok-bg:#DAF1E9;--late:#8A4B00;--late-bg:#FBE7C2;--abs:#A61B12;--abs-bg:#FCDCD8;
  --miss:#B23A07;--miss-bg:#FFE2CF;--leave:#4E35A3;--leave-bg:#E7E0FA;--off:#6B7885;--off-bg:#E6EAEE;
  --nos:#1B5596;--nos-bg:#D9E6F6;--hol:#B3261E;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);
  color-scheme:light;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0F1720;--surface:#17212C;--surface2:#1D2935;--ink:#E3E9EF;--muted:#93A3B3;--line:#2B3947;
  --brand:#0B2440;--brand-ink:#E3E9EF;--focus:#6EA2F0;
  --ok:#6FD6B7;--ok-bg:#173A31;--late:#F1BD6A;--late-bg:#3D2E14;--abs:#FF9A90;--abs-bg:#43201D;
  --miss:#FFAD7E;--miss-bg:#432817;--leave:#BBA8FF;--leave-bg:#2C2550;--off:#9AA7B4;--off-bg:#25303B;
  --nos:#8EBBF0;--nos-bg:#1A2E47;--hol:#FF8A80;color-scheme:dark;}}
:root[data-theme="dark"]{
  --bg:#0F1720;--surface:#17212C;--surface2:#1D2935;--ink:#E3E9EF;--muted:#93A3B3;--line:#2B3947;
  --brand:#0B2440;--brand-ink:#E3E9EF;--focus:#6EA2F0;
  --ok:#6FD6B7;--ok-bg:#173A31;--late:#F1BD6A;--late-bg:#3D2E14;--abs:#FF9A90;--abs-bg:#43201D;
  --miss:#FFAD7E;--miss-bg:#432817;--leave:#BBA8FF;--leave-bg:#2C2550;--off:#9AA7B4;--off-bg:#25303B;
  --nos:#8EBBF0;--nos-bg:#1A2E47;--hol:#FF8A80;color-scheme:dark;}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:14px/1.5 "Be Vietnam Pro",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;font-variant-numeric:tabular-nums}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);z-index:10;background:var(--brand)}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--focus);outline-offset:1px}
.brand{font-weight:700;font-size:17px;letter-spacing:.01em;display:flex;align-items:center;gap:10px}
.brand .clock{width:22px;height:22px;border:2px solid currentColor;border-radius:50%;position:relative}
.brand .clock::before,.brand .clock::after{content:"";position:absolute;left:50%;top:50%;width:2px;background:currentColor;transform-origin:50% 0}
.brand .clock::before{height:7px;transform:translate(-50%,0) rotate(180deg)}
.brand .clock::after{height:5px;transform:translate(-50%,0) rotate(-90deg)}
.month{display:flex;align-items:center;gap:4px}
.month button{background:transparent;border:1px solid rgba(255,255,255,.28);color:inherit;border-radius:6px;width:32px;height:32px;cursor:pointer}
.month strong{min-width:132px;text-align:center;font-size:15px}
.role{font-size:12px;padding:3px 10px;border-radius:99px;background:rgba(255,255,255,.14)}
.count{display:inline-block;min-width:18px;padding:0 5px;margin-left:6px;border-radius:99px;background:#F2C14E;color:#1B1B1B;font-size:11px;font-weight:700;text-align:center}
main{padding:18px 20px 60px;width:100%;max-width:1800px;margin:0 auto;box-sizing:border-box}
.shell{display:flex;min-height:100vh}
.sidebar{width:240px;flex:none;background:var(--brand);color:var(--brand-ink);position:sticky;top:0;height:100vh;overflow-y:auto;display:flex;flex-direction:column;padding-top:env(safe-area-inset-top,0px);z-index:25}
.sidebar .brand{padding:16px 18px 14px;margin:0;font-size:16px}
.modsw{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:0 12px 10px}
.modsw button{border:1px solid rgba(255,255,255,.22);background:transparent;color:inherit;border-radius:8px;padding:9px 4px 7px;cursor:pointer;font-weight:600;font-size:12.5px;display:grid;justify-items:center;gap:4px}
.modsw button svg{width:20px;height:20px}
.modsw button[aria-pressed="true"]{background:#fff;color:#12355B}
.sidebar nav{display:block;padding:2px 8px 24px}
.navh{font-size:11px;text-transform:uppercase;letter-spacing:.06em;opacity:.6;padding:12px 10px 6px}
.sidebar nav a{display:flex;align-items:center;gap:9px;color:inherit;text-decoration:none;padding:8px 10px;border-radius:6px;opacity:.82;font-weight:500;font-size:13.5px;border:0}
.sidebar nav a svg{width:16px;height:16px;flex:none;opacity:.85}
.sidebar nav a:hover{background:rgba(255,255,255,.08);opacity:1}
.sidebar nav a[aria-current="page"]{background:rgba(255,255,255,.16);opacity:1;box-shadow:inset 3px 0 0 #F2C14E}
.sidebar nav a .count{margin-left:auto}
.mainwrap{flex:1;min-width:0;display:flex;flex-direction:column}
.topbar{position:sticky;top:0;z-index:20;background:var(--surface);border-bottom:1px solid var(--line);display:flex;align-items:center;gap:14px;padding:10px 20px;flex-wrap:wrap}
.crumb{font-weight:600;font-size:15px;margin-right:auto}
.crumb span{color:var(--muted);font-weight:500}
.topbar .month button{border:1px solid var(--line);color:var(--ink);background:var(--surface)}
.topbar .role{background:var(--surface2);color:var(--muted)}
.lockpill{font-size:12px;font-weight:600;padding:3px 10px;border-radius:99px}
.steps{display:flex;margin:4px 0 16px;flex-wrap:wrap;gap:4px}
.steps div{flex:1;min-width:150px;padding:10px 12px;border:1px solid var(--line);background:var(--surface);font-size:13px;color:var(--muted);border-radius:6px}
.steps div b{display:block;font-size:12px;font-weight:600;margin-bottom:2px}
.steps div.done{background:var(--ok-bg);color:var(--ok);border-color:transparent}
.steps div.cur{background:var(--brand);color:#fff;border-color:var(--brand)}
.cardx{padding:16px 18px;margin-bottom:16px}
.cardx h2{font-size:16px;margin:0 0 4px}
.chk{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:8px;margin:12px 0}
.chk div{padding:10px 12px;border-radius:6px;background:var(--surface2);font-size:13px}
.chk div b{display:block;font-size:20px}
.chk div.bad{background:var(--abs-bg);color:var(--abs)}
.chk div.good{background:var(--ok-bg);color:var(--ok)}
@media (max-width:900px){.shell{display:block}.sidebar{position:static;width:auto;height:auto;flex-direction:row;flex-wrap:wrap;align-items:center}.sidebar .brand{padding:10px 14px}.modsw{grid-template-columns:auto auto;padding:6px 10px}.sidebar nav{display:flex;overflow-x:auto;gap:2px;width:100%;padding:0 8px 8px}.navh{display:none}.sidebar nav a{white-space:nowrap}.sidebar nav > div{display:contents}}

.view{display:none}.view.on{display:block}
.toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.toolbar .grow{flex:1}
input[type=text],input[type=search],input[type=date],input[type=time],input[type=number],select,textarea{background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:7px 10px;min-height:36px}
textarea{width:100%;min-height:70px;resize:vertical}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:7px 14px;cursor:pointer;font-weight:500;min-height:36px}
.btn.primary{background:var(--brand);border-color:var(--brand);color:#fff}
.btn.ok{background:var(--ok);border-color:var(--ok);color:var(--surface)}
.btn.no{color:var(--abs);border-color:var(--abs)}
.btn:disabled{opacity:.5;cursor:not-allowed}
.btn.sm{padding:3px 10px;min-height:28px;font-size:13px}
.note{color:var(--muted);font-size:13px}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:8px}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;color:var(--muted);margin:0 0 10px}
.legend span{display:inline-flex;align-items:center;gap:6px}
.legend i{width:14px;height:14px;border-radius:3px;display:inline-block}
/* grid */
.gridwrap{overflow:auto;max-height:calc(100vh - 230px);border:1px solid var(--line);border-radius:8px;background:var(--surface)}
table.grid{border-collapse:separate;border-spacing:0;font-size:12.5px}
.grid th,.grid td{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:0}
.grid thead th{position:sticky;top:0;background:var(--surface2);z-index:3;font-weight:600;text-align:center;padding:4px 2px}
.grid thead tr:nth-child(2) th{top:27px;font-weight:500;color:var(--muted);font-size:11px}
.grid .sticky{position:sticky;left:0;background:var(--surface);z-index:2}
.grid .sticky2{position:sticky;left:72px;background:var(--surface);z-index:2;box-shadow:1px 0 0 var(--line)}
.grid thead .sticky,.grid thead .sticky2{z-index:4;background:var(--surface2)}
.grid td.ma{width:72px;min-width:72px;padding:4px 6px;font-weight:600;font-size:12px}
.grid td.ten{min-width:170px;max-width:190px;padding:4px 8px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.grid td.ten small{display:block;color:var(--muted);font-size:11px}
.grid th.wk{color:var(--hol)}
.grid th.hol{background:color-mix(in srgb,var(--hol) 14%,var(--surface2))}
.grid tr.dept td{background:var(--surface2);font-weight:700;padding:6px 8px;font-size:12px;color:var(--muted)}
.grid td.d{width:46px;min-width:46px;height:40px;position:relative;text-align:center;vertical-align:top;cursor:pointer}
.grid td.d input{width:100%;border:0;background:transparent;text-align:center;font-weight:600;font-size:12px;padding:4px 0 0;min-height:0;height:21px;text-transform:uppercase;cursor:pointer}
.grid td.d input:focus{outline:none;cursor:text}
.grid td.d.sel{box-shadow:inset 0 0 0 2px var(--focus)}
.grid td.d i{display:block;font-style:normal;font-size:10px;line-height:14px;height:14px;white-space:nowrap;overflow:hidden}
.grid td.d b.tag{position:absolute;top:1px;right:2px;font-size:9px;line-height:1}
.s-ok{background:var(--ok-bg);color:var(--ok)}
.s-late{background:var(--late-bg);color:var(--late)}
.s-abs{background:var(--abs-bg);color:var(--abs)}
.s-miss{background:var(--miss-bg);color:var(--miss)}
.s-leave{background:var(--leave-bg);color:var(--leave)}
.s-pend{background:repeating-linear-gradient(135deg,var(--leave-bg) 0 5px,var(--surface) 5px 10px);color:var(--leave)}
.s-nodoc{background:var(--surface);color:var(--abs);box-shadow:inset 0 0 0 2px var(--abs)}
.s-off{background:var(--off-bg);color:var(--off)}
.s-nos{background:var(--nos-bg);color:var(--nos)}
.s-err{background:var(--abs);color:#fff}
.s-err input{color:#fff}
.s-fut{color:var(--muted)}
.grid td.sum{padding:4px 8px;text-align:right;white-space:nowrap;font-weight:600}
.grid td.kl{padding:4px 8px;white-space:nowrap;font-weight:600;font-size:12px}
.pill{display:inline-block;padding:2px 9px;border-radius:99px;font-size:12px;font-weight:600;white-space:nowrap}
/* drawer */
.drawer{position:fixed;right:16px;bottom:16px;width:min(380px,calc(100vw - 32px));max-height:70vh;overflow:auto;z-index:30;padding:16px 18px;box-shadow:0 12px 32px rgba(0,0,0,.22);display:none;margin-bottom:env(safe-area-inset-bottom,0px)}
.drawer.on{display:block}
.drawer h3{margin:0 0 2px;font-size:16px}
.drawer dl{display:grid;grid-template-columns:110px 1fr;gap:4px 10px;margin:12px 0}
.drawer dt{color:var(--muted)}
.drawer dd{margin:0;font-weight:500}
.drawer .x{position:absolute;right:10px;top:8px;border:0;background:none;font-size:20px;cursor:pointer;color:var(--muted)}
/* summary */
.kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-bottom:14px}
.kpi{padding:12px 14px}
.kpi b{display:block;font-size:26px;line-height:1.1}
.kpi span{color:var(--muted);font-size:13px}
.tbl{width:100%;border-collapse:collapse;font-size:13px}
.tbl th,.tbl td{padding:7px 9px;border-bottom:1px solid var(--line);text-align:left;vertical-align:top}
.tbl th{background:var(--surface2);font-weight:600;position:sticky;top:0;cursor:pointer;white-space:nowrap}
.tbl td.n,.tbl th.n{text-align:right}
.scroll{overflow:auto;max-height:calc(100vh - 290px)}
/* requests */
.two{display:grid;grid-template-columns:minmax(280px,380px) 1fr;gap:16px;align-items:start}
@media (max-width:860px){.two{grid-template-columns:1fr}}
form.req{padding:16px;display:grid;gap:10px}
form.req label{display:grid;gap:4px;font-size:13px;color:var(--muted)}
form.req label > *{color:var(--ink)}
.seg{display:flex;border:1px solid var(--line);border-radius:6px;overflow:hidden}
.seg button{flex:1;border:0;background:var(--surface);padding:8px;cursor:pointer;font-weight:500}
.seg button[aria-pressed="true"]{background:var(--brand);color:#fff}
.row2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.cards{display:grid;gap:10px}
.card{padding:12px 14px;display:grid;gap:6px;border-left:4px solid var(--line)}
.card.cho{border-left-color:#E0A100}.card.duyet{border-left-color:var(--ok)}.card.tuchoi{border-left-color:var(--abs)}
.card .top{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.card .top strong{font-size:14.5px}
.card .meta{color:var(--muted);font-size:12.5px}
.card .act{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.card .act input{flex:1;min-width:140px}
.p-cho{background:#FBEFC8;color:#7A5600}.p-duyet{background:var(--ok-bg);color:var(--ok)}.p-tuchoi{background:var(--abs-bg);color:var(--abs)}
.tabs2{display:flex;gap:6px;flex-wrap:wrap}
.tabs2 button{border:1px solid var(--line);background:var(--surface);border-radius:99px;padding:4px 12px;cursor:pointer;font-size:13px}
.tabs2 button[aria-pressed="true"]{background:var(--ink);color:var(--surface);border-color:var(--ink)}
/* settings */
.settings{display:grid;gap:16px}
.settings section{padding:14px 16px}
.settings h2{font-size:15px;margin:0 0 10px}
.ed td{padding:3px 4px}
.ed input,.ed select{min-height:30px;padding:3px 6px;width:100%}
.ed td.del button{border:0;background:none;color:var(--abs);cursor:pointer;font-size:16px}
.drop{border:2px dashed var(--line);border-radius:8px;padding:22px;text-align:center;background:var(--surface)}
.drop.hover{border-color:var(--focus)}
.sheettabs{display:flex;gap:2px;overflow-x:auto;border-bottom:2px solid var(--brand);margin-bottom:10px;padding-top:2px}
.sheettabs button{flex:none;border:1px solid var(--line);border-bottom:0;background:var(--surface2);color:var(--muted);padding:6px 12px;border-radius:6px 6px 0 0;cursor:pointer;font-size:13px;white-space:nowrap}
.sheettabs button[aria-selected="true"]{background:var(--brand);color:#fff;border-color:var(--brand);font-weight:600}
.sheettabs button.extra{font-style:italic}
.xl{border-collapse:separate;border-spacing:0;font-size:12.5px;background:var(--surface)}
.xl th,.xl td{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:4px 7px;white-space:nowrap}
.xl thead th{position:sticky;top:0;background:var(--surface2);z-index:2;font-weight:600;text-align:center;white-space:normal;min-width:64px;vertical-align:bottom}
.xl thead tr.g th{top:0;background:color-mix(in srgb,var(--brand) 12%,var(--surface2));color:var(--ink)}
.xl thead tr.h th{top:var(--gh,0px)}
.xl td.n{text-align:right;font-variant-numeric:tabular-nums}
.xl td.c{text-align:center}
.xl .s1{position:sticky;left:0;background:var(--surface);z-index:1}
.xl .s2{position:sticky;left:var(--s1w,70px);background:var(--surface);z-index:1;box-shadow:1px 0 0 var(--line);min-width:160px}
.xl thead .s1,.xl thead .s2{z-index:3;background:var(--surface2)}
.xl tr.dept td{background:var(--surface2);font-weight:700;color:var(--muted)}
.xl tr.dept td.s1{background:var(--surface2)}
.xl tfoot td{position:sticky;bottom:0;background:var(--surface2);font-weight:700;z-index:1}
.xl td.ed{padding:0;background:color-mix(in srgb,#F2C14E 14%,var(--surface))}
.xl td.ed input,.xl td.ed select{border:0;background:transparent;width:100%;min-width:70px;min-height:26px;padding:3px 6px;font:inherit;color:#1d4ed8;text-align:right}
.xl td.ed input[type=text],.xl td.ed input:not([type]),.xl td.ed input[type=date]{text-align:left}
.xl td.ed input[type=checkbox]{width:auto;min-width:0}
.xl td.hl{font-weight:700}
.xlwrap{overflow:auto;max-height:calc(100vh - 300px);border:1px solid var(--line);border-radius:8px}
.svcbox{display:grid;gap:12px}
@media print{#slipInline,#slipInline *{visibility:visible!important}#slipInline{position:absolute;inset:0;background:#fff;color:#000;padding:0;border:0}}

.seg2{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:12px}
.seg2 button{border:1px solid var(--line);background:var(--surface);border-radius:6px;padding:6px 12px;cursor:pointer;font-weight:500}
.seg2 button[aria-pressed="true"]{background:var(--brand);color:#fff;border-color:var(--brand)}
.tbl td.m,.tbl th.m{text-align:right;white-space:nowrap}
.tbl tr.dept td{background:var(--surface2);font-weight:700;color:var(--muted)}
.tbl tr.click{cursor:pointer}
.tbl tr.click:hover td{background:color-mix(in srgb,var(--focus) 8%,var(--surface))}
.tbl tfoot td{font-weight:700;background:var(--surface2);position:sticky;bottom:0}
.tbl td.warn{color:var(--abs);font-size:12px;max-width:220px}
.banner{padding:10px 14px;border-radius:8px;margin-bottom:12px;border:1px solid var(--line);background:var(--surface);display:flex;gap:12px;align-items:center;flex-wrap:wrap}
.banner.lock{border-color:var(--ok);background:var(--ok-bg);color:var(--ok)}
.banner.drift{border-color:var(--late);background:var(--late-bg);color:var(--late)}
.ed input[type=number]{text-align:right}
.ed td.ro{color:var(--muted);white-space:nowrap}
.s-ot{background:var(--nos-bg);color:var(--nos)}
#slipDlg{width:min(760px,96vw)}
.slip h2{margin:0;font-size:18px}
.slip .sub{color:var(--muted);margin:2px 0 10px}
.slip table{width:100%;border-collapse:collapse;font-size:13px;margin-top:8px}
.slip td,.slip th{padding:5px 8px;border-bottom:1px solid var(--line);text-align:left}
.slip td.n,.slip th.n{text-align:right;white-space:nowrap}
.slip tr.h td{font-weight:700;background:var(--surface2)}
.slip tr.total td{font-weight:700;font-size:15px;border-top:2px solid var(--ink)}
.psgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:10px 18px}
.psgrid label{display:grid;gap:3px;font-size:13px;color:var(--muted)}
@media print{body *{visibility:hidden!important}#slipDlg,#slipDlg *{visibility:visible!important}#slipDlg{position:absolute;inset:0;width:100%;max-width:none;border:0;box-shadow:none;background:#fff;color:#000}#slipDlg .noprint{display:none!important}}

dialog{border:1px solid var(--line);border-radius:8px;padding:18px 20px;width:min(540px,92vw);background:var(--surface);color:var(--ink)}
dialog::backdrop{background:rgba(0,0,0,.4)}
dialog ul{margin:4px 0 8px;padding-left:18px}
.toast{position:fixed;left:50%;bottom:24px;transform:translateX(-50%);background:var(--ink);color:var(--surface);padding:10px 16px;border-radius:8px;z-index:40;font-size:13px;display:none;max-width:90vw;margin-bottom:env(safe-area-inset-bottom,0px)}
.toast.on{display:block}
.empty{padding:40px 20px;text-align:center;color:var(--muted)}
.hide{display:none!important}
@media (prefers-reduced-motion:no-preference){.drawer.on{animation:rise .18s ease-out}@keyframes rise{from{transform:translateY(8px);opacity:0}}}
</style>
</head>
<body>
<div class="shell">
<aside class="sidebar" aria-label="Điều hướng">
  <div class="brand"><span class="clock" aria-hidden="true"></span>Classyc HRM</div>
