async function boot(){wire();wirePay();$$(".modsw button").forEach(b=>b.onclick=()=>{location.hash=b.dataset.mod==="cc"?"bang-cong":"ky-luong"});onMonth();
  const timer=setTimeout(()=>{if(!S.loadedCfg)$("#boot").textContent="Chưa tải được dữ liệu. Hãy mở link khi đã đăng nhập Claude và có quyền truy cập trang này."},10000);
  try{[db,user,dl]=await Promise.all([claude.use("db"),claude.use("user"),claude.use("downloads")])}catch(e){}
  if(!db){clearTimeout(timer);$("#boot").textContent="Trang cần đăng nhập Claude để xem và lưu dữ liệu chấm công.";$("#roleLbl").textContent="Chưa đăng nhập";return}
  try{uid=await user?.id();isAdmin=!!(await user?.canEdit());const cw=await user?.can?.("data.write");canWrite=cw==null?true:!!cw}catch(e){}
  $("#roleLbl").textContent=isAdmin?"Quản lý":(canWrite?"Nhân viên":"Chỉ xem");
  if(!canWrite)$("#rSubmit").disabled=true;
  if(isAdmin){$("#modLuong").classList.remove("hide");subHR();$("#impLichBtn").classList.remove("hide");$("#lichTplBtn").classList.remove("hide")}
  const err=e=>{clearTimeout(timer);if(e?.code==="revoked")toast("Quyền truy cập đã thay đổi.")};
  db.doc("cfg/settings").onSnapshot(s=>{clearTimeout(timer);S.cfg=s.exists?s.data():null;S.loadedCfg=true;if(!document.activeElement?.closest?.(".settings"))draft=null;schedule()},err);
  db.doc("cfg/nhanvien").onSnapshot(s=>{S.emps=s.exists?(s.data().list||[]):[];S.loadedEmp=true;gridKey="";schedule()},err);
  db.collection("yeucau").onSnapshot(q=>{S.reqs=q.docs.map(d=>({id:d.id,...d.data()}));schedule()},err);
  db.collection("congtt").onSnapshot(q=>{S.ctt=Object.fromEntries(q.docs.map(d=>[d.id,d.data()]));gridKey="";schedule()},err);
  db.collection("pheduyet").onSnapshot(q=>{S.appr=Object.fromEntries(q.docs.map(d=>[d.id,d.data()]));schedule()},err);
  subMonth()}
boot();
})();
</script>
