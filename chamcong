let LI=null;
const dnum=v=>typeof v==="number"&&Number.isInteger(v)?v:(typeof v==="string"&&/^\s*\d{1,2}\s*$/.test(v)?+v:null);
function dayHeader(rows){let best=null;
  for(let r=0;r<Math.min(rows.length,60);r++){const row=rows[r]||[];const cols=[];
    for(let c=0;c<row.length;c++){const v=row[c];let dt=null;
      if((typeof v==="number"&&v>20000&&v<80000)||v instanceof Date||(typeof v==="string"&&/^\s*\d{1,2}[\/\-.]\d{1,2}[\/\-.]\d{4}/.test(v)))dt=xlDate(v);
      if(dt)cols.push({c,dt})}
    if(cols.length>=7){const cnt={};cols.forEach(x=>{const k=x.dt.slice(0,7);cnt[k]=(cnt[k]||0)+1});const mk=Object.keys(cnt).sort((a,b)=>cnt[b]-cnt[a])[0];
      const map=cols.filter(x=>x.dt.slice(0,7)===mk).map(x=>({c:x.c,d:+x.dt.slice(8)}));
      if(!best||best.type!=="date"||map.length>best.map.length)best={r,map,mk,type:"date"};continue}
    for(let c=0;c<row.length;c++){if(dnum(row[c])!==1)continue;let k=c,exp=1;const map=[];
      while(k<row.length&&dnum(row[k])===exp){map.push({c:k,d:exp});k++;exp++}
      if(map.length>=28&&map.length<=31&&(!best||(best.type!=="date"&&map.length>best.map.length)))best={r,map,mk:null,type:"num"}}}
  return best}
function empCol(rows,start){const keys=new Map();S.emps.forEach(e=>{keys.set(String(e.ma).toUpperCase(),e.ma);if(e.maVT)keys.set(String(e.maVT).toUpperCase(),e.ma)});
  const nameKeys=new Map(S.emps.map(e=>[String(e.ten).trim().toLowerCase(),e.ma]));const score={};
  for(let r=start;r<rows.length;r++)(rows[r]||[]).forEach((v,c)=>{if(typeof v!=="string"&&typeof v!=="number")return;const s=String(v).trim();if(!s)return;
    if(keys.has(s.toUpperCase()))score["m"+c]=(score["m"+c]||0)+1;else if(nameKeys.has(s.toLowerCase()))score["n"+c]=(score["n"+c]||0)+1});
  const k=Object.keys(score).sort((a,b)=>score[b]-score[a]||(a[0]==="m"?-1:1))[0];
  return k?{type:k[0],c:+k.slice(1),keys,nameKeys}:null}
function titleMonth(rows){for(const row of rows.slice(0,12))for(const v of row||[]){const m=/tháng\s*(\d{1,2})\s*[\/\-.]\s*(\d{4})/i.exec(String(v));if(m)return m[2]+"-"+pad(m[1])}return null}
async function readLichFile(f){const wb=XLSX.read(await f.arrayBuffer(),{type:"array"});let best=null;
  for(const sn of wb.SheetNames){const rows=XLSX.utils.sheet_to_json(wb.Sheets[sn],{header:1,raw:true,defval:""});const h=dayHeader(rows);if(!h)continue;const ec=empCol(rows,h.r+1);if(!ec)continue;
    const data={},unknown=new Set(),bad=new Set();let cells=0;
    for(let r=h.r+1;r<rows.length;r++){const row=rows[r]||[];const idv=String(row[ec.c]??"").trim();if(!idv)continue;
      const ma=ec.type==="m"?ec.keys.get(idv.toUpperCase()):ec.nameKeys.get(idv.toLowerCase());
      const vals=h.map.map(x=>({d:x.d,v:row[x.c]})).filter(x=>typeof x.v==="string"&&x.v.trim());if(!vals.length)continue;
      if(!ma){unknown.add(idv);continue}
      data[ma]=data[ma]||{};vals.forEach(x=>{const code=String(x.v).trim().toUpperCase().replace(/\s+/g,"");data[ma][x.d]=code;cells++;code.split("/").forEach(p=>{if(p&&!SM[p])bad.add(p)})})}
