    R.bhNld={bhxh:bh*cfg.bhNld.bhxh,bhyt:bh*cfg.bhNld.bhyt,bhtn:bh*cfg.bhNld.bhtn};R.bhNldTong=R.bhNld.bhxh+R.bhNld.bhyt+R.bhNld.bhtn;
