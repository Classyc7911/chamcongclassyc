function xlTime(v){if(v==null||v==="")return null;if(typeof v==="number"){if(v>=0&&v<2){const m=Math.round((v%1)*1440);return pad(Math.floor(m/60)%24)+":"+pad(m%60)}return null}
  if(v instanceof Date)return pad(v.getHours())+":"+pad(v.getMinutes());const m=/^\s*(\d{1,2}):(\d{2})/.exec(String(v));return m?pad(m[1])+":"+m[2]:null}
function xlDate(v){if(typeof v==="number"&&v>20000&&v<80000){const d=new Date(Math.round((v-25569)*86400000));return ymd(d.getUTCFullYear(),d.getUTCMonth()+1,d.getUTCDate())}
  if(v instanceof Date)return ymd(v.getFullYear(),v.getMonth()+1,v.getDate());
  const m=/^\s*(\d{1,2})[\/\-.](\d{1,2})[\/\-.](\d{4})/.exec(String(v||""));if(m)return ymd(+m[3],+m[2],+m[1]);
  const m2=/^\s*(\d{4})-(\d{2})-(\d{2})/.exec(String(v||""));return m2?m2[1]+"-"+m2[2]+"-"+m2[3]:null}
