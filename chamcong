const WORK_RE=/^(HC\d?|A\d+|M\d+|SP\d+|BZ|FL|WD)$/, NIGHT_RE=/^NG\d?$/, SPLIT_RE=/^SP\d+$/;
const rnd=(x,d=0)=>{const p=10**d;return Math.round((x+Number.EPSILON*Math.sign(x))*p)/p};
function monthDays(mk){const [y,m]=mk.split("-").map(Number);const n=new Date(y,m,0).getDate();const a=[];for(let d=1;d<=n;d++){const wd=new Date(y,m-1,d).getDay();a.push({d,wd,date:y+"-"+String(m).padStart(2,"0")+"-"+String(d).padStart(2,"0")})}return a}
function congChuanP(mk,loai){let c=0;for(const x of monthDays(mk)){if(loai==="VP"){if(x.wd>=1&&x.wd<=5)c+=1;else if(x.wd===6)c+=.5}else if(x.wd!==0)c+=1}return c}
function dayType(date,holidays){const h=(holidays||[]).find(x=>x.ngay===date);return h?((+h.heSo||200)>=300?3:2):1}
/* Count one employee's working categories for a month, split TV/CT. */
function countDays(e,mk,lichE,holidays,opts){
  const z=()=>({thuong:0,le200:0,le300:0,nghiLe:0,phep:0,nghiBu:0,gio:0,dem:0,dem200:0,dem300:0,caGay:0,ngayLe:0});
  const C={tv:z(),ct:z(),khongVT:0,unknown:[]};
  for(const day of monthDays(mk)){
    if(e.ngayvao&&day.date<e.ngayvao)continue;
    let raw=lichE?.[day.d];if(raw==null||raw==="")continue;raw=String(raw).trim().toUpperCase();
    const k=(e.ngayCT&&day.date<e.ngayCT)?C.tv:C.ct;const t=dayType(day.date,holidays);
    if(/^\d+(\.\d+)?$/.test(raw)){k.gio+=(+raw)/8;continue}
    const parts=raw.split("/").filter(Boolean);const w=1/parts.length;
    const noVT=opts?.noVT?.(day)||false;
    for(const p of parts){
      if(WORK_RE.test(p)){if(noVT){C.khongVT+=w;continue}
        if(t===1)k.thuong+=w;else if(t===2)k.le200+=w;else k.le300+=w;
        if(t>1)k.ngayLe+=w;
        if(SPLIT_RE.test(p))k.caGay+=w}
      else if(NIGHT_RE.test(p)){if(noVT){C.khongVT+=w;continue}
        if(t===1)k.dem+=w;else if(t===2)k.dem200+=w;else k.dem300+=w;if(t>1)k.ngayLe+=w}
      else if(p==="PH")k.nghiLe+=w;
      else if(p==="AL")k.phep+=w;
      else if(p==="CLPH")k.nghiBu+=w;
      else if(["OFF","UP","ML"].includes(p)){}
      else C.unknown.push(day.d+":"+p)}}
  return C}
function sumCong(k){return k.thuong+k.le200+k.le300+k.nghiLe+k.phep+k.nghiBu+k.gio+k.dem+k.dem200+k.dem300}
