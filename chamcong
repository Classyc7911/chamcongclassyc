/* Main: returns {rows, totals} */
function computePayroll(ctx){
  const cfg={...PAY_DEFAULT,...(ctx.cfg||{})};const mk=ctx.month;const [Y,M]=mk.split("-").map(Number);
  const rows=[];
  for(const e of ctx.emps){
    if(e.nghiViec&&e.nghiViec<mk+"-01")continue;
    const C=countDays(e,mk,ctx.lich[e.ma],ctx.holidays,{noVT:cfg.congTheoVT&&!e.mienVT?ctx.noVT?.(e):null});
    const inp=ctx.inputs?.[e.ma]||{};
    const P=congChuanP(mk,e.loaiCong);
    const luongCT=+e.luongCT||0, luongTV=+e.luongTV||luongCT*cfg.tyLeTV;
    const rTV=P?luongTV/P:0, rCT=P?luongCT/P:0;
    const both=(f,mul=1,d=1)=>rnd(rTV*C.tv[f]*mul+rCT*C.ct[f]*mul,d);
    const otH=ctx.ot?.[e.ma]||{};let otTV=0,otCT=0;
    for(const day of monthDays(mk)){const h=+otH[day.d]||0;if(!h)continue;if(e.ngayCT&&day.date<e.ngayCT)otTV+=h/8;else otCT+=h/8}
    const R={ma:e.ma,e,P,C,otTV,otCT,rTV,rCT,inp};
    R.congTV=sumCong(C.tv);R.congCT=sumCong(C.ct);R.tongCong=R.congTV+R.congCT;
    R.lThuong=both("thuong");R.lLe200=both("le200",2,0);R.lLe300=both("le300",3,0);
    R.lNghiLe=both("nghiLe");R.lPhep=both("phep");R.lNghiBu=both("nghiBu");R.lGio=both("gio");
    R.lTangCa=rnd((rTV*otTV+rCT*otCT)*cfg.heSoTangCa,1);
    R.lDem=both("dem");R.lDem200=both("dem200",2);R.lDem300=both("dem300",3);
    R.pcDem=both("dem",cfg.pcCaDem);R.pcDem200=both("dem200",2*cfg.pcCaDemLe+cfg.pcCaDem);R.pcDem300=both("dem300",3*cfg.pcCaDemLe+cfg.pcCaDem);
    R.pcCaGay=(C.tv.caGay+C.ct.caGay)*cfg.pcCaGay;R.pcTN=+e.pcTN||0;
    R.tongLuong=R.lThuong+R.lLe200+R.lLe300+R.lNghiLe+R.lPhep+R.lNghiBu+R.lGio+R.lTangCa+R.lDem+R.lDem200+R.lDem300+R.pcDem+R.pcDem200+R.pcDem300+R.pcCaGay+R.pcTN;
    const congDem=C.tv.dem+C.tv.dem200+C.tv.dem300+C.ct.dem+C.ct.dem200+C.ct.dem300;
    R.congAnDem=congDem;R.congAnLe=inp.congAnLe!=null&&inp.congAnLe!==""?+inp.congAnLe:(C.tv.ngayLe+C.ct.ngayLe);
    R.anCa=rnd(congDem*cfg.anCaDem)+R.congAnLe*cfg.anCaLe;
    R.pcXe=+e.pcXe||0;R.pcDT=+e.pcDT||0;R.pcXang=+e.pcXang||0;R.pcKhac=(+e.pcKhac||0)+(+inp.pcKhacThang||0);
    R.tongPC=R.anCa+R.pcXe+R.pcDT+R.pcXang+R.pcKhac;
    // SVC (công + hours, pool split later)
    const ex=k=>sumCong(k)-k.phep-k.nghiBu;
    R.svcCong=e.huongSVC===false?0:rnd(ex(C.tv)/2+ex(C.ct)+otTV/2+otCT,4);
    R.svcGioCong=R.svcCong*(+e.svcGio||8);
    R.svcPhat=+(ctx.svcPhat?.(e)??0)||0;R.svcViPham=(+inp.svcViPham||0);
    R.hhSpa=+inp.hhSpa||0;R.kpi=+inp.kpi||0;
    R.sinhNhat=inp.sinhNhat!=null&&inp.sinhNhat!==""?+inp.sinhNhat:((e.ngaySinh&&+e.ngaySinh.slice(5,7)===M&&R.tongCong>0)?cfg.sinhNhat:0);
    R.hoanThue=+inp.hoanThue||0;R.hoanKhongThue=+inp.hoanKhongThue||0;
    R.tamUng=+inp.tamUng||0;R.hoanNet=+inp.hoanNet||0;R.truyThu=+inp.truyThu||0;
    const bh=+e.luongBH||0;
