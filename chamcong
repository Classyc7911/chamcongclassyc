function edRaw(ed,v){if(ed.kind==="inp"){const o=curThang().inputs?.[ed.ma]||{};let x=o[ed.k];if(ed.k==="hhSpaHB"||ed.k==="hhSpaHT")x=spaPart({ma:ed.ma},ed.k)||"";return x==null||x===""?"":(ed.pct?+(x*100).toFixed(3):x)}
  if(ed.kind==="hs"){const x=HSv()[ed.ma]?.[ed.k];if(ed.type==="checkbox")return ed.k==="huongSVC"?x!==false:!!x;return x??""}
  if(ed.kind==="cas"){const c=curThang().casual?.[ed.i]||{};return c[ed.k]??""}
  if(ed.kind==="thang"){const x=curThang()[ed.k];return x??""}
  if(ed.kind==="ot")return S.ot[ed.ma]?.[ed.d]??"";return v}
function applyEdit(ed,el){const val=el.type==="checkbox"?el.checked:el.value;
  if(ed.kind==="ot"){queueOT(ed.ma,ed.d,String(val));return}
  if(ed.kind==="hs"){HS=HS||clone(H.hoso)||{};const o=HS[ed.ma]=HS[ed.ma]||{};o[ed.k]=ed.type==="number"?(val===""?"":+val):val;saveHosoSoon();schedule();return}
  if(locked()){toast("Tháng đã chốt – mở chốt trước khi sửa.");schedule();return}
  ensureHI();
  if(ed.kind==="thang"){HI[ed.k]=val===""?"":+val}
  else if(ed.kind==="cas"){const c=HI.casual[ed.i];if(c)c[ed.k]=ed.type==="number"?+val||0:val}
  else{const o=HI.inputs[ed.ma]=HI.inputs[ed.ma]||{};
    if((ed.k==="hhSpaHB"||ed.k==="hhSpaHT")&&o.hhSpaHB==null&&o.hhSpaHT==null&&o.hhSpa){o.hhSpaHB=+o.hhSpa;delete o.hhSpa}
    if(val===""){delete o[ed.k]}else o[ed.k]=ed.pct?(+val||0)/100:+val}
  saveThangSoon();schedule()}

