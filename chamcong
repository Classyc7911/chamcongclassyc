<script>
(function(){
"use strict";
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
const WD=["CN","T2","T3","T4","T5","T6","T7"];
const S={cfg:null,emps:[],lich:{},vt:{},vtNext:{},ot:{},reqs:[],appr:{},loadedCfg:false,loadedEmp:false};
let db=null,user=null,dl=null,uid=null,isAdmin=false,canWrite=true,unsubM=[],names={};
let month=(()=>{try{const m=localStorage.getItem("cc-month");if(/^\d{4}-\d{2}$/.test(m))return m}catch(e){}const d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")})();
let gridMode="ca",reqType="doica",reqFilter="cho",selCell=null,rafId=0,gridKey="";

function toast(t,ms=3200){const el=$("#toast");el.textContent=t;el.classList.add("on");clearTimeout(el._t);el._t=setTimeout(()=>el.classList.remove("on"),ms)}
const pad=n=>String(n).padStart(2,"0");
const toMin=s=>{if(!s)return null;const m=/^(\d{1,2}):(\d{2})/.exec(s);return m?(+m[1])*60+(+m[2]):null};
const fmtMin=m=>pad(Math.floor(((m%1440)+1440)%1440/60))+":"+pad(((m%60)+60)%60);
const ymd=(y,m,d)=>y+"-"+pad(m)+"-"+pad(d);
function mInfo(mk){const [y,m]=mk.split("-").map(Number);const n=new Date(y,m,0).getDate();const days=[];for(let d=1;d<=n;d++){const dt=new Date(y,m-1,d);days.push({d,date:ymd(y,m,d),wd:dt.getDay()})}return {y,m,n,days}}
const shiftMk=(mk,k)=>{let [y,m]=mk.split("-").map(Number);m+=k;while(m<1){m+=12;y--}while(m>12){m-=12;y++}return y+"-"+pad(m)};
const todayStr=(()=>{const d=new Date();return ymd(d.getFullYear(),d.getMonth()+1,d.getDate())})();
const shiftMap=()=>{const o={};(S.cfg?.shifts||[]).forEach(s=>{if(s.ma)o[String(s.ma).toUpperCase()]=s});return o};
let SM={};
const empByMa=ma=>S.emps.find(e=>e.ma===ma);
const LOAI={lam:"Làm",off:"Nghỉ tuần/lễ",phep:"Nghỉ cần duyệt",congtac:"Công tác"};

/* ---------- requests index ---------- */
let RIDX={};
function reqStatus(r){return S.appr[r.id]?.trangThai||"cho"}
function datesBetween(a,b){const out=[];if(!a)return out;let d=new Date(a+"T00:00:00"),e=new Date((b||a)+"T00:00:00");let g=0;while(d<=e&&g++<62){out.push(ymd(d.getFullYear(),d.getMonth()+1,d.getDate()));d.setDate(d.getDate()+1)}return out}
function buildIdx(){RIDX={};const add=(k,v)=>(RIDX[k]=RIDX[k]||[]).push(v);
  for(const r of S.reqs){const st=reqStatus(r);
    if(r.loai==="tangca"){add(r.ma+"|"+r.ngay,{r,st})}
    else if(r.loai==="doica"){add(r.ma+"|"+r.ngay,{r,st});if(r.voiMa)add(r.voiMa+"|"+r.ngay,{r,st})}
    else datesBetween(r.tuNgay,r.denNgay).forEach(d=>add(r.ma+"|"+d,{r,st}))}}

/* ---------- core evaluation ---------- */
function ev(e,day,mi){
  const code=(S.lich[e.ma]?.[day.d]||"").toString().trim().toUpperCase();
  const punches=(S.vt[e.ma]?.[day.d]||[]).slice();
  const R={code,punches,cls:"",txt:"",late:0,early:0,cong:0,issue:"",swap:false,pend:false,work:false,shift:null,half:false};
  const rel=RIDX[e.ma+"|"+day.date]||[];
  R.swap=rel.some(x=>x.r.loai==="doica"&&x.st==="duyet");
  R.pend=rel.some(x=>x.st==="cho");
  if(e.ngayvao&&day.date<e.ngayvao){R.cls="";return R}
  const future=day.date>todayStr;
  if(!code){if(punches.length){R.cls="s-nos";R.txt=punches[0];R.issue="Có vân tay nhưng chưa xếp ca"}return R}
  const parts=code.split("/").map(s=>s.trim()).filter(Boolean);
  const infos=parts.map(p=>SM[p]);
  if(infos.some(x=>!x)){R.cls="s-err";R.txt="mã lạ";R.issue="Mã ca “"+code+"” không có trong Thiết lập";return R}
  const w=1/parts.length;R.half=parts.length>1;
  const work=infos.find(s=>s.loai==="lam");
  // leave/congtac parts
  let leaveState="";
  for(const s of infos){
    if(s.loai==="phep"||s.loai==="congtac"){
      const ok=rel.some(x=>x.r.loai==="nghi"&&x.st==="duyet"&&String(x.r.loaiNghi).toUpperCase()===s.ma.toUpperCase());
      const pe=rel.some(x=>x.r.loai==="nghi"&&x.st==="cho");
      if(ok){R.cong+=w*(+s.cong||0);leaveState=leaveState||"ok"}
      else{leaveState=pe?"pend":"nodoc"}
    } else if(s.loai==="off"){R.cong+=w*(+s.cong||0)}
  }
  if(!work){
    if(leaveState==="nodoc"){R.cls="s-nodoc";R.txt="chưa đơn";R.issue="Nghỉ “"+code+"” chưa có đơn được duyệt"}
    else if(leaveState==="pend"){R.cls="s-pend";R.txt="chờ duyệt"}
    else if(leaveState==="ok"){R.cls="s-leave";R.txt="đã duyệt"}
    else {R.cls="s-off";R.txt=punches.length?"có VT":""}
    if(punches.length&&infos.some(s=>s.loai==="phep")){R.issue=(R.issue?R.issue+"; ":"")+"Ngày nghỉ nhưng có vân tay "+punches.join(" ")}
    return R}
  R.work=true;R.shift=work;
  if(future&&!punches.length){R.cls="s-fut";return R}
  if(!punches.length){R.cls="s-abs";R.txt="không VT";R.issue="Có ca "+code+" nhưng không có vân tay";return R}
  let start=toMin(work.vao),end=toMin(work.ra2||work.ra);
  const t=punches.map(toMin);let inT=t[0],outT=t.length>1?t[t.length-1]:null;
  if(t.length===1&&start!=null&&end!=null){const e2=end%1440;const dIn=Math.min(Math.abs(t[0]-start),1440-Math.abs(t[0]-start)),dOut=Math.min(Math.abs(t[0]-e2),1440-Math.abs(t[0]-e2));if(dOut<dIn){outT=t[0];inT=null}}
  const overnight=end!=null&&start!=null&&end<=start;
  if(overnight){end+=1440;
    if(outT!=null&&inT!=null&&outT<inT)outT+=1440;
    else if(outT==null&&inT!=null){const nx=(day.d<mi.n?S.vt[e.ma]?.[day.d+1]:S.vtNext[e.ma]?.["1"])||[];const f=toMin(nx[0]);if(f!=null&&f<=end-1440+180)outT=f+1440}}
  R.cong+=w*(+work.cong||1);
  if(outT==null||inT==null){R.cls="s-miss";R.txt="quên chấm";R.issue="Chỉ có 1 lần chấm ("+punches[0]+(inT==null?", tính là giờ ra":", tính là giờ vào")+")"}
  const gIn=+S.cfg?.choPhepMuon||0,gOut=+S.cfg?.choPhepSom||0;
  if(start!=null&&inT!=null){const l=inT-start;if(l>gIn&&!(R.half&&end!=null&&l>(end-start)/2))R.late=l}
  if(!R.half&&end!=null&&outT!=null&&inT!=null){const s=end-outT;if(s>gOut)R.early=s}
  if(R.cls)return R;
  if(R.late||R.early){R.cls="s-late";R.txt=(R.late?"+"+R.late+"'":"")+(R.late&&R.early?" ":"")+(R.early?"−"+R.early+"'":"")}
  else{R.cls="s-ok";R.txt=punches[0]}
  if(leaveState==="nodoc"){R.issue="Nửa ngày nghỉ chưa có đơn";R.cls="s-nodoc"}
  return R}

function congChuan(e,mi){let c=0;for(const d of mi.days){if(e.ngayvao&&d.date<e.ngayvao)continue;if(e.loaiCong==="VP"){if(d.wd>=1&&d.wd<=5)c+=1;else if(d.wd===6)c+=.5}else if(d.wd!==0)c+=1}return c}
function summarize(e,mi){
  const s={cong:0,lam:0,muon:0,phutMuon:0,som:0,phutSom:0,quen:0,vang:0,nodoc:0,pend:0,phep:0,doi:0,ma:0,nos:0,b1:0,b2:0,b3:0,b4:0,cells:[]};
  for(const d of mi.days){const r=ev(e,d,mi);s.cells.push(r);s.cong+=r.cong;
    if(r.work&&r.punches.length)s.lam++;
    if(r.late){s.muon++;s.phutMuon+=r.late;if(r.late<6)s.b1++;else if(r.late<31)s.b2++;else if(r.late<60)s.b3++;else s.b4++}
    if(r.early){s.som++;s.phutSom+=r.early}
    if(r.cls==="s-miss")s.quen++;if(r.cls==="s-abs")s.vang++;if(r.cls==="s-nodoc")s.nodoc++;if(r.cls==="s-pend")s.pend++;
    if(r.cls==="s-leave")s.phep+=r.half?.5:1;if(r.swap)s.doi++;if(r.cls==="s-err")s.ma++;if(r.cls==="s-nos")s.nos++}
  s.chuan=congChuan(e,mi);
  const c5=s.b1,c30=s.b2,c45=s.b3,q=s.quen;
  s.svc=Math.min(1,(c5<4?0:.03*(2**(c5-3)-1))+(c30<1?0:Math.min(1,.04*(2**c30-1)))+(c45<1?0:c45===1?.3:c45===2?.9:1)+(q<3?0:Math.min(1,.15*(2**(q-2)-1))));
  s.loi=s.quen+s.vang+s.nodoc+s.ma+s.nos;
  s.kl=s.loi>0?"Cần xử lý":(s.cong>=s.chuan?"Đủ công":"Thiếu công");
  return s}
const klPill=k=>`<span class="pill ${k==="Đủ công"?"s-ok":k==="Thiếu công"?"s-late":"s-abs"}">${k}</span>`;

