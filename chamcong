/* edits: batched writes to lichca/<month> */
let pending={},flushT=0;
function queueEdit(ma,d,code){if(congLocked()){toast(lockMsg(month));schedule();return}if(gridMode==="ot"){queueOT(ma,d,code);return}code=code.trim().toUpperCase();(pending[ma]=pending[ma]||{})[d]=code;S.lich[ma]=S.lich[ma]||{};S.lich[ma][d]=code;schedule();clearTimeout(flushT);flushT=setTimeout(flush,500)}
async function writeLich(mk,patch,coll="lichca",field="ca"){const ref=db.doc(coll+"/"+mk);
  try{await ref.update({[field]:patch})}catch(err){
    if(err?.code==="invalid_argument"){const g=await ref.get();if(!g.exists){await ref.set({[field]:patch});return}}
    throw err}}
let pendingOT={},flushOTT=0;
function queueOT(ma,d,v){if(congLocked()){toast(lockMsg(month));schedule();return}v=String(v).trim().replace(",",".");const h=v===""?"":+v;if(v!==""&&!(h>=0&&h<=24)){toast("Giờ tăng ca phải là số từ 0 đến 24.");schedule();return}
  (pendingOT[ma]=pendingOT[ma]||{})[d]=h;S.ot[ma]=S.ot[ma]||{};S.ot[ma][d]=h;schedule();clearTimeout(flushOTT);flushOTT=setTimeout(async()=>{const p=pendingOT;pendingOT={};
  try{await writeLich(month,p,"tangca","gio")}catch(err){toast("Không lưu được giờ tăng ca: "+(err?.message||err?.code))}},500)}
async function flush(){if(!db||!Object.keys(pending).length)return;const p=pending;pending={};
  try{await writeLich(month,p)}catch(err){toast("Không lưu được ca: "+(err?.message||err?.code||"lỗi")+". Bạn cần quyền quản lý.")}}

function gridEvents(){
  const wrap=$("#gridwrap");
  wrap.addEventListener("focusin",ev2=>{const td=ev2.target.closest("td.d");if(!td)return;const ma=td.parentNode.dataset.ma,d=+td.dataset.d;selCell={ma,d};
    wrap.querySelectorAll("td.sel").forEach(x=>x.classList.remove("sel"));td.classList.add("sel");showDrawer(ma,d)});
  wrap.addEventListener("change",ev2=>{const inp=ev2.target;const td=inp.closest("td.d");if(!td||!isAdmin)return;queueEdit(td.parentNode.dataset.ma,td.dataset.d,inp.value)});
  wrap.addEventListener("keydown",ev2=>{const inp=ev2.target;const td=inp.closest?.("td.d");if(!td)return;
    const k=ev2.key;let tr=td.parentNode,idx=+td.dataset.d,nt=null;
    const go=(r,i)=>{if(!r)return null;return r.querySelector(`td.d[data-d="${i}"]`)};
    const nextRow=(r,dir)=>{let x=dir>0?r.nextElementSibling:r.previousElementSibling;while(x&&!x.dataset.ma)x=dir>0?x.nextElementSibling:x.previousElementSibling;return x};
    if(k==="Enter"){ev2.preventDefault();inp.dispatchEvent(new Event("change",{bubbles:true}));nt=go(nextRow(tr,ev2.shiftKey?-1:1),idx)}
    else if(k==="ArrowDown")nt=go(nextRow(tr,1),idx);else if(k==="ArrowUp")nt=go(nextRow(tr,-1),idx);
    else if(k==="ArrowRight"&&(inp.readOnly||inp.selectionStart===inp.value.length))nt=go(tr,idx+1);
    else if(k==="ArrowLeft"&&(inp.readOnly||inp.selectionStart===0))nt=go(tr,idx-1);
    else if((k==="Delete")&&isAdmin&&inp.selectionStart===0&&inp.selectionEnd===inp.value.length){inp.value="";queueEdit(tr.dataset.ma,idx,"");ev2.preventDefault()}
    if(nt){ev2.preventDefault();const i2=nt.firstChild;i2.focus();i2.select?.()}});
  wrap.addEventListener("paste",ev2=>{const td=ev2.target.closest?.("td.d");if(!td||!isAdmin)return;const txt=ev2.clipboardData.getData("text");if(!/[\t\n]/.test(txt.trim()))return;
    ev2.preventDefault();const rows=txt.replace(/\r/g,"").replace(/\n$/,"").split("\n").map(r=>r.split("\t"));
    let tr=td.parentNode;const d0=+td.dataset.d,n=mInfo(month).n;let cnt=0;
    for(const row of rows){if(!tr)break;row.forEach((v,j)=>{const d=d0+j;if(d<=n){queueEdit(tr.dataset.ma,d,v);cnt++}});
      let x=tr.nextElementSibling;while(x&&!x.dataset.ma)x=x.nextElementSibling;tr=x}
    toast("Đã dán "+cnt+" ô ca.")});
}

