    for(const mk of months){const ref=db.doc("vantay/"+mk);const g=await ref.get();const nv={...(g.exists?g.data().nv||{}:{})};Object.assign(nv,out[mk]);await ref.set({nv,capNhat:new Date().toISOString()})}
